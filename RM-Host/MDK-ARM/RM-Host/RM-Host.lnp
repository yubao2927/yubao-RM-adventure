--cpu Cortex-M3
"rm-host\startup_stm32f103xb.o"
"rm-host\master_comm.o"
"rm-host\main.o"
"rm-host\gpio.o"
"rm-host\tim.o"
"rm-host\usart.o"
"rm-host\stm32f1xx_it.o"
"rm-host\stm32f1xx_hal_msp.o"
"rm-host\stm32f1xx_hal_gpio_ex.o"
"rm-host\stm32f1xx_hal_tim.o"
"rm-host\stm32f1xx_hal_tim_ex.o"
"rm-host\stm32f1xx_hal.o"
"rm-host\stm32f1xx_hal_rcc.o"
"rm-host\stm32f1xx_hal_rcc_ex.o"
"rm-host\stm32f1xx_hal_gpio.o"
"rm-host\stm32f1xx_hal_dma.o"
"rm-host\stm32f1xx_hal_cortex.o"
"rm-host\stm32f1xx_hal_pwr.o"
"rm-host\stm32f1xx_hal_flash.o"
