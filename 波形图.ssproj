            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 1,
            "frameEnd": "0D",
            "frameParserCode": "/**\n * Comma-Separated Values (CSV) Parser\n *\n * Parses comma-separated data into an array of values.\n *\n * INPUT FORMAT: \"a,b,c,d,e,f\"\n * OUTPUT ARRAY: [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\"]\n *\n * Note: Frame delimiters are automatically removed by Serial Studio.\n */\n\n//------------------------------------------------------------------------------\n// Frame Parser Function\n//------------------------------------------------------------------------------\n\n/**\n * Parses a CSV frame into an array of values.\n *\n * @param {string} frame - The CSV data from the data source\n * @returns {array} Array of string values\n */\nfunction parse(frame) {\n  return frame.split(',');\n}\nfunction parse(frame) {\n    \n    \n    // 2. 解析四元数 (Float32，小端字节序)\n    const q0 = new Float32Array(new Uint8Array(frame.slice(3, 7)).buffer)[0];\n    const q1 = new Float32Array(new Uint8Array(frame.slice(7, 11)).buffer)[0];\n    const q2 = new Float32Array(new Uint8Array(frame.slice(11, 15)).buffer)[0];\n    const q3 = new Float32Array(new Uint8Array(frame.slice(15, 19)).buffer)[0];\n    \n    // 3. 解析欧拉角 (Int16，小端字节序，原值为角度 × 100)\n    const roll  = new Int16Array(new Uint8Array(frame.slice(19, 21)).buffer)[0] / 100.0;\n    const pitch = new Int16Array(new Uint8Array(frame.slice(21, 23)).buffer)[0] / 100.0;\n    const yaw   = new Int16Array(new Uint8Array(frame.slice(23, 25)).buffer)[0] / 100.0;\n    \n    // 4. 返回数值数组，顺序对应数据集 IDX 1~7\n    return [roll, pitch, yaw, q0, q1, q2, q3];\n}",
            "frameParserParams": {
                "quoteChar": "",
                "separator": ",",
                "skipEmpty": false,
                "trimFields": false
            },
            "frameParserTemplate": "delimited",
            "frameStart": "AA 55",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "设备 A"
        }
    ],
