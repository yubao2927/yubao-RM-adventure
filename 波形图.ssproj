    "sources": [
        {
            "busType": 0,
            "checksum": "",
            "checksumAlgorithm": "",
            "connection": {
                "autoReconnect": false,
                "baudRate": 460800,
                "dataBitsIndex": 3,
                "deviceId": {
                    "description": "USB-SERIAL CH340",
                    "pid": "7523",
                    "portName": "COM9",
                    "vid": "1A86"
                },
                "dtr": true,
                "flowControlIndex": 0,
                "parityIndex": 0,
                "portIndex": 2,
                "stopBitsIndex": 0
            },
            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 1,
            "frameEnd": "0D",
            "frameParserCode": "/**\n * MPU6050 attitude frame parser (binary).\n * Frame delimiters AA 55 / 0D are removed by Serial Studio;\n * parse() receives 24 bytes: [0]=type, [1..4]=q0, [5..8]=q1, [9..12]=q2,\n * [13..16]=q3, [17..18]=roll*100, [19..20]=pitch*100, [21..22]=yaw*100, [23]=CRC8.\n */\nfunction parse(frame) {\n    function f32(a) { return new Float32Array(new Uint8Array(a).buffer)[0]; }\n    function i16(a) { return new Int16Array(new Uint8Array(a).buffer)[0]; }\n    const q0 = f32(frame.slice(1, 5));\n    const q1 = f32(frame.slice(5, 9));\n    const q2 = f32(frame.slice(9, 13));\n    const q3 = f32(frame.slice(13, 17));\n    const roll  = i16(frame.slice(17, 19)) / 100.0;\n    const pitch = i16(frame.slice(19, 21)) / 100.0;\n    const yaw   = i16(frame.slice(21, 23)) / 100.0;\n    return [roll, pitch, yaw, q0, q1, q2, q3];\n}",
            "frameParserParams": {
                "quoteChar": "",
                "separator": ",",
                "skipEmpty": false,
                "trimFields": false
            },
            "frameParserTemplate": "delimited",
            "frameStart": "AA 55",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "设备 A"
        }
    ],
